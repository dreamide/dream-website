{
  "$schema": "./node_modules/@umami/shiso/docs.schema.json",
  "theme": "shiso",
  "name": "Dream",
  "description": "Dream is an open-source desktop IDE for working with AI coding agents.",
  "favicon": "/dream.png",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#0a0a0a"
    }
  },
  "colors": {
    "primary": "#bbf7d0"
  },
  "pages": [
    {
      "path": "/",
      "page": "home"
    },
    {
      "path": "/download",
      "page": "download"
    },
    {
      "path": "/hello",
      "page": "hello"
    }
  ],
  "navbar": {
    "links": [
      {
        "icon": "book-open",
        "label": "Docs",
        "href": "/docs"
      },
      {
        "icon": "github",
        "ariaLabel": "Dream on GitHub",
        "href": "https://github.com/umami-software/dream"
      }
    ],
    "primary": {
      "label": "Download",
      "icon": "download",
      "href": "/download"
    }
  },
  "footer": {
    "socials": [
      {
        "icon": "github",
        "ariaLabel": "Dream on GitHub",
        "href": "https://github.com/umami-software/dream"
      },
      {
        "icon": "discord",
        "ariaLabel": "Dream on Discord",
        "href": "https://discord.gg/HxRQRzpkD"
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view"]
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "collapsible": false,
        "pages": [
          {
            "page": "index",
            "title": "Introduction"
          },
          "installation",
          "providers",
          "first-project"
        ]
      },
      {
        "group": "Chats",
        "pages": [
          "chats",
          "multiple-chats",
          "providing-context",
          "agent-modes",
          "branching-chats",
          "stash",
          "archived-chats",
          "context-and-usage"
        ]
      },
      {
        "group": "Workspace tools",
        "pages": ["workspace", "files", "terminals", "browser"]
      },
      {
        "group": "Git",
        "pages": ["git-workflows", "worktrees"]
      },
      {
        "group": "Configuration and help",
        "pages": ["models", "settings", "troubleshooting"]
      }
    ]
  }
}
