{
  "name": "dream-website",
  "version": "0.1.0",
  "private": true,
  "description": "The Dream website and documentation, built with Shiso.",
  "type": "module",
  "scripts": {
    "locales": "node scripts/generate-locales.mjs",
    "dev": "shiso dev --config vite.config.ts --port 6001",
    "check": "shiso check",
    "build": "shiso build --config vite.config.ts",
    "preview": "shiso preview --outDir dist/client",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mdx-js/react": "3.1.1",
    "@umami/shiso": "1.19.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "typescript": "^6.0.3",
    "unified": "11.0.5",
    "vite": "8.2.2"
  }
}
